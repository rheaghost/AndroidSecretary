                .build();

         *///old request 2601172339


        // Inside runAILogic:
        String final_url;
        if(isRunPodMode) {
            String targetUrl_runpod = buildFinalUrl();
            final_url=targetUrl_runpod;

        }
        else
        {
            //replaced to /api/chat 2606081013
